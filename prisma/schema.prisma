  bookingId  String   @map("booking_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  role       String?  @db.VarChar(100)
  startTime  DateTime @map("start_time")
  endTime    DateTime @map("end_time")
  notes      String?
  checkedIn  Boolean  @default(false) @map("checked_in")
  checkedOut Boolean  @default(false) @map("checked_out")
  createdAt  DateTime @default(now()) @map("created_at")

  booking Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   PropertyStaff @relation(fields: [staffId], references: [id])

  @@unique([bookingId, staffId])
  @@map("booking_staff_assignments")
}

// =============================================================================
// BDE INCENTIVE / COMMISSION ENGINE
// =============================================================================

model CommissionPlan {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String              @db.VarChar(200)
  propertyId    String?             @map("property_id") @db.Uuid // null = org-wide default
  basis         CommissionSlabBasis
  isActive      Boolean             @default(true) @map("is_active")
  effectiveFrom DateTime            @map("effective_from") @db.Date
  effectiveTo   DateTime?           @map("effective_to") @db.Date
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  slabs       CommissionSlab[]
  commissions BdeCommission[]

  @@index([propertyId])
  @@map("commission_plans")
}

model CommissionSlab {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId         String   @map("plan_id") @db.Uuid
  minAmount      Decimal  @map("min_amount") @db.Decimal(12, 2)
  maxAmount      Decimal? @map("max_amount") @db.Decimal(12, 2) // null = no upper limit
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 2) // percentage, e.g., 2.50

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("commission_slabs")
}

model BdeCommission {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId        String    @unique @map("booking_id") @db.Uuid
  bdeId            String    @map("bde_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  grossRevenue     Decimal   @map("gross_revenue") @db.Decimal(12, 2)
  totalExpenses    Decimal   @map("total_expenses") @db.Decimal(12, 2)
  netMargin        Decimal   @map("net_margin") @db.Decimal(12, 2) // grossRevenue - totalExpenses
  commissionBase   Decimal   @map("commission_base") @db.Decimal(12, 2)
  commissionRate   Decimal   @map("commission_rate") @db.Decimal(5, 2)
  commissionAmount Decimal   @map("commission_amount") @db.Decimal(12, 2)
  isPaid           Boolean   @default(false) @map("is_paid")
  paidAt           DateTime? @map("paid_at")
  paymentRef       String?   @map("payment_ref") @db.VarChar(100)
  notes            String?
  computedAt       DateTime  @default(now()) @map("computed_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  booking Booking        @relation(fields: [bookingId], references: [id])
  bde     User           @relation(fields: [bdeId], references: [id])
  plan    CommissionPlan @relation(fields: [planId], references: [id])

  @@index([bdeId])
  @@index([isPaid])
  @@map("bde_commissions")
}

// =============================================================================
// EXTERNAL CALENDAR SYNC (iCal / Airbnb)
// =============================================================================

model ExternalCalendarSync {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId          String                   @map("property_id") @db.Uuid
  provider            ExternalCalendarProvider
  calendarName        String?                  @map("calendar_name") @db.VarChar(200)
  icalUrl             String                   @map("ical_url")
  lastSyncedAt        DateTime?                @map("last_synced_at")
  syncIntervalMinutes Int                      @default(60) @map("sync_interval_minutes")
  isActive            Boolean                  @default(true) @map("is_active")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  property               Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  externalCalendarEvents ExternalCalendarEvent[]
  bookings               Booking[]

  @@index([propertyId])
  @@map("external_calendar_syncs")
}

model ExternalCalendarEvent {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  syncId            String    @map("sync_id") @db.Uuid
  uid               String    @db.VarChar(500) // UID from .ics VEVENT
  summary           String?   @db.VarChar(500)
  description       String?
  startTime         DateTime  @map("start_time")
  endTime           DateTime  @map("end_time")
  location          String?   @db.VarChar(300)
  status            String?   @db.VarChar(50) // CONFIRMED / TENTATIVE / CANCELLED per iCal spec
  rawPayload        Json      @map("raw_payload")
  isBlocking        Boolean   @default(true) @map("is_blocking")
  lastUpdatedInFeed DateTime? @map("last_updated_in_feed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  sync ExternalCalendarSync @relation(fields: [syncId], references: [id], onDelete: Cascade)

  @@unique([syncId, uid])
  @@index([syncId, startTime, endTime])
  @@map("external_calendar_events")
}

// =============================================================================
// BOOKING OPERATIONS
// =============================================================================

model BookingChecklist {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  task         String    @db.VarChar(500)
  assignedTo   String?   @map("assigned_to") @db.VarChar(200)
  dueTime      DateTime? @map("due_time")
  isCompleted  Boolean   @default(false) @map("is_completed")
  completedAt  DateTime? @map("completed_at")
  notes        String?
  displayOrder Int       @default(0) @map("display_order")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_checklists")
}

model BookingDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId     String   @map("booking_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(100) // CONTRACT, NOC, FLOOR_PLAN
  fileName      String   @map("file_name") @db.VarChar(300)
  fileUrl       String   @map("file_url")
  fileSizeBytes Int?     @map("file_size_bytes")
  mimeType      String?  @map("mime_type") @db.VarChar(100)
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_documents")
}

// =============================================================================
// AUDIT / ACTIVITY LOG
// =============================================================================

model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  entityType    String   @map("entity_type") @db.VarChar(100) // Booking, Invoice, Lead, etc.
  entityId      String   @map("entity_id") @db.Uuid
  action        String   @db.VarChar(100) // CREATED, STATUS_CHANGED, AMOUNT_EDITED, etc.
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  ipAddress     String?  @map("ip_address") @db.VarChar(45)
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}

// =============================================================================
// SUPPORTING MODELS
// =============================================================================

model GstCodeMaster {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codeType    String  @map("code_type") @db.VarChar(3) // SAC or HSN
  code        String  @unique @db.VarChar(8)
  description String
  gstRate     Decimal @map("gst_rate") @db.Decimal(5, 2)
  cgstRate    Decimal @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate    Decimal @map("sgst_rate") @db.Decimal(5, 2)
  igstRate    Decimal @map("igst_rate") @db.Decimal(5, 2)
  isActive    Boolean @default(true) @map("is_active")

  @@index([codeType])
  @@map("gst_code_master")
}

model TermsTemplate {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @db.VarChar(200)
  content        String
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("terms_templates")
}

// =============================================================================
// AI TASKS
// =============================================================================

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  assignedTo  String?   @map("assigned_to")
  priority    String    @default("NORMAL")   // HIGH, MEDIUM, NORMAL
  deadline    DateTime? @db.Date
  status      String    @default("PENDING")  // PENDING, ONGOING, COMPLETED
  category    String    @default("GENERAL")  // FOLLOW_UP, FINANCE, OPERATIONS, ADMIN, GENERAL
  relatedRef  String?   @map("related_ref")
  source      String    @default("MANUAL")   // MANUAL, AI
  notes       String?
  propertyId  String?   @map("property_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  property Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([propertyId, status])
  @@map("tasks")
}

model NotificationLog {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channel       String    @db.VarChar(20) // EMAIL, SMS, WHATSAPP
  recipient     String    @db.VarChar(255)
  subject       String?   @db.VarChar(500)
  body          String?
  entityType    String?   @map("entity_type") @db.VarChar(100)
  entityId      String?   @map("entity_id") @db.Uuid
  status        String    @default("PENDING") @db.VarChar(20) // PENDING, SENT, FAILED
  providerRef   String?   @map("provider_ref") @db.VarChar(200)
  sentAt        DateTime? @map("sent_at")
  failureReason String?   @map("failure_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([status])
  @@map("notification_logs")
}
