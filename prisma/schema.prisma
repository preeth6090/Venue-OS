  propertyId     String                @map("property_id") @db.Uuid
  vendorId       String?               @map("vendor_id") @db.Uuid // null = direct hire
  firstName      String                @map("first_name") @db.VarChar(100)
  lastName       String                @map("last_name") @db.VarChar(100)
  staffRole      StaffRole             @map("staff_role")
  category       String?               @db.VarChar(50) // security, housekeeping, maintenance, etc.
  shift          String?               @db.VarChar(100)
  vendorName     String?               @map("vendor_name") @db.VarChar(200)
  phone          String                @db.VarChar(20)
  alternatePhone String?               @map("alternate_phone") @db.VarChar(20)
  aadhaarRef     String?               @map("aadhaar_ref") @db.VarChar(20) // Masked last-4 only
  policeVerified Boolean               @default(false) @map("police_verified")
  bgCheckStatus  BackgroundCheckStatus @default(NOT_INITIATED) @map("bg_check_status")
  bgvAgencyName  String?               @map("bgv_agency_name")
  bgvCertUrl     String?               @map("bgv_cert_url")
  bgvExpiresAt   DateTime?             @map("bgv_expires_at") @db.Date // SLA renewal deadline
  photoUrl       String?               @map("photo_url")
  joiningDate    DateTime?             @map("joining_date") @db.Date
  isActive       Boolean               @default(true) @map("is_active")
  notes          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

