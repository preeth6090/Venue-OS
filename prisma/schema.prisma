// =============================================================================
// VENDOR MANAGEMENT
// =============================================================================

model Vendor {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String                @db.VarChar(300)
  category          VendorCategory
  complianceTier    VendorComplianceTier  @map("compliance_tier")
  contactPersonName String?               @map("contact_person_name") @db.VarChar(200)
  phone             String                @db.VarChar(20)
  alternatePhone    String?               @map("alternate_phone") @db.VarChar(20)
  email             String?               @db.VarChar(255)
  gstin             String?               @db.VarChar(15)
  pan               String?               @db.VarChar(10)
  gstTreatment      GstTreatment          @default(UNREGISTERED) @map("gst_treatment")
  addressLine1      String?               @map("address_line1")
  addressLine2      String?               @map("address_line2")
  city              String?               @db.VarChar(100)
  state             String?               @db.VarChar(100)
  pincode           String?               @db.VarChar(10)
  baseRatePerEvent  Decimal?              @map("base_rate_per_event") @db.Decimal(12, 2)
  baseRatePerPax    Decimal?              @map("base_rate_per_pax") @db.Decimal(12, 2)
  rateNotes         String?               @map("rate_notes")
  // STRICT-tier compliance fields (security/housekeeping agencies)
  policeVerified    Boolean               @default(false) @map("police_verified")
  bgvAgencyName     String?               @map("bgv_agency_name")
  bgvCertUrl        String?               @map("bgv_cert_url")
  bgvExpiresAt      DateTime?             @map("bgv_expires_at") @db.Date
  licenseNumber     String?               @map("license_number")
  licenseExpiresAt  DateTime?             @map("license_expires_at") @db.Date
  bgCheckStatus     BackgroundCheckStatus @default(NOT_INITIATED) @map("bg_check_status")
  rating            Decimal?              @db.Decimal(3, 2)
  isBlacklisted     Boolean               @default(false) @map("is_blacklisted")
  blacklistReason   String?               @map("blacklist_reason")
  notes             String?
  tags              String[]
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  propertyLinks      PropertyVendor[]
  bookingAssignments BookingVendorAssignment[]
  suppliedStaff      PropertyStaff[]           @relation("StaffSuppliedByVendor")
  expenses           Expense[]
  bgvSlaLogs         VendorBgvSlaLog[]

  @@index([category])
  @@index([complianceTier])
  @@index([bgCheckStatus])
  @@map("vendors")
}

model PropertyVendor {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId  String   @map("property_id") @db.Uuid
  vendorId    String   @map("vendor_id") @db.Uuid
  isPreferred Boolean  @default(false) @map("is_preferred")
  addedAt     DateTime @default(now()) @map("added_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([propertyId, vendorId])
  @@map("property_vendors")
}

model BookingVendorAssignment {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String    @map("booking_id") @db.Uuid
  vendorId     String    @map("vendor_id") @db.Uuid
  serviceDesc  String?   @map("service_desc")
  agreedAmount Decimal?  @map("agreed_amount") @db.Decimal(12, 2)
  paidAmount   Decimal   @default(0) @map("paid_amount") @db.Decimal(12, 2)
  notes        String?
  confirmedAt  DateTime? @map("confirmed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id])

  @@unique([bookingId, vendorId])
  @@map("booking_vendor_assignments")
}

model VendorBgvSlaLog {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendorId       String                @map("vendor_id") @db.Uuid
  previousStatus BackgroundCheckStatus @map("previous_status")
  newStatus      BackgroundCheckStatus @map("new_status")
  changedBy      String?               @map("changed_by") @db.Uuid
  notes          String?
  dueDate        DateTime?             @map("due_date") @db.Date
  resolvedAt     DateTime?             @map("resolved_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_bgv_sla_logs")
}

